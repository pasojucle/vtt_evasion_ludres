{% extends 'base_admin.html.twig' %}

{% block title %}{{ view.title }}{% endblock %}


{% block body %}
    <div class="p-4 lg:p-6">
        <div class="flex mt-4">
            <div>
                <h1 class="font-bold text-3xl">{{ view.title }} </h1>
                <div class="text-muted mt-1">{{ view.description|raw }}</div>
            </div>
            <div class="ml-auto">
                <div class="flex flex-col lg:flex-row items-center rounded-sm divide-y lg:divide-y-0 lg:divide-x divide-white">
                    {% include "components/_link.html.twig" with {link: view.fallback} %}
                </div>
            </div>
        </div>
        <div id="summaries_container" class="mt-4 grid grid-cols-1 lg:grid-cols-2 gap-4">

            {% if view.items is empty %}
                <div class="border border-border rounded-md flex flex-col">
                    {% include view.empty.template with {icon : view.empty.icon, message: view.empty.message} %}
                </div>
            {% endif %}

            {% include view.addAction.template with {(view.addAction.name): view.addAction} %}
            
            {% for item in view.items %}
                {% include item.template with {(item.name): item} %}
            {% endfor %}

        </div>
    </div>
{% endblock %}
