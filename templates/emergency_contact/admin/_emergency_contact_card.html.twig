<div class="px-4 bg-slate-300 flex items-center h-8">
    <div class="text-xs font-semibold uppercase text-white">
        <h2>Contact d'urgence</h2>
    </div>
    <div class="ml-auto -mr-2">
        {% include view.action.template with {(view.action.name): view.action} %}
    </div>
</div>
<div class="p-4 2xl:p-6">
    <dl class="flex flex-col gap-2 text-sm">
        <div class="flex flex-col">
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Téléphone :</dt>
            <dd class="font-medium">
                {% include "components/_phone.html.twig" with {view: view.phone} %}
            </dd>
        </div>

        <div class="flex flex-col">
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Lien de parenté :</dt>
            <dd class="text-foreground font-medium">
                {{ view.kinship }}<br>
            </dd>
        </div>
        
    </dl>
</div>