<div class="px-4 bg-slate-300 flex items-center h-8">
    <div class="text-xs font-semibold uppercase text-white">
        <h2>Identité</h2>
    </div>
    <div class="ml-auto -mr-2">
        {% include view.action.template with {(view.action.name): view.action} %}
    </div>
</div>
<div class="p-4 2xl:p-6">
    <dl class="flex flex-col gap-2 text-sm">
        <div class="flex gap-4 items-center">
            <div class="w-32 h-32 p-2 flex items-center justify-center border border-border rounded-sm">
                <img 
                    class="w-full h-full object-contain" src="{{ view.passportPhoto }}" 
                    alt="{{ view.fullName }}" 
                >
            </div>
            <div class="flex flex-col 2xl:flex-row 2xl:items-start 2xl:gap-x-2">
                <dt class="text-xs font-semibold uppercase tracking-wider text-muted 2xl:leading-5">Nom :</dt>
                <dd class="font-medium">
                    {{ view.fullName }}
                </dd>
            </div>
        </div>
        <div class="flex flex-col 2xl:flex-row 2xl:items-start 2xl:gap-x-2">
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted 2xl:leading-5">Né(e) le :</dt>
            <dd class="text-foreground font-medium">
                {{ view.birthDate }}<br>
                {% if view.birthPlace %}
                    <span class="text-muted/80">à {{ view.birthPlace }}</span>
                {% endif %}
            </dd>
        </div>

        <div class="flex flex-col 2xl:flex-row 2xl:items-start 2xl:gap-x-2">
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted 2xl:leading-5">Adresse :</dt>
            <dd class="text-foreground font-medium">
                {{ view.address }}<br>
                <span>{{ view.city }}</span>
            </dd>
        </div>

        <div class="flex flex-col 2xl:flex-row 2xl:items-start 2xl:gap-x-2">
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted 2xl:leading-5">Mail :</dt>
            <dd class="font-medium">
                {% include "components/_phone.html.twig" with {view: view.email} %}
            </dd>
        </div>

        <div class="flex flex-col 2xl:flex-row 2xl:items-start 2xl:gap-x-2">
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted 2xl:leading-5">Téléphones :</dt>
            <dd class="text-foreground font-medium tracking-wide flex items-center gap-2">
                {% for phone in view.phones %}
                    {% include "components/_phone.html.twig" with {view: phone} %}
                    {% if loop.index < view.phones|length %}
                        <div class="text-muted text-xs">{{ ux_icon('lucide:circle-small') }}</div>
                    {% endif %}
                {% endfor %}
            </dd>
        </div>
        {% if view.profession %}
            <div class="flex flex-col 2xl:flex-row 2xl:items-start 2xl:gap-x-2">
                <dt class="text-xs font-semibold uppercase tracking-wider text-muted 2xl:leading-5">Profession :</dt>
                <dd class="text-foreground font-medium">
                    {{ view.profession }}<br>
                </dd>
            </div>
        {% endif %}
    </dl>
</div>