{% extends 'base_sheet.html.twig' %}
{% block body %}
    <div class="mb-2 flex flex-col gap-4">
        {{ form_row(form.name) }}
        {{ form_row(form.firstName) }}
        {{ form_row(form.passportPhoto) }}
        {{ form_row(form.address) }}
        {{ form_row(form.email) }}
        {{ form_row(form.mobile) }}
        {{ form_row(form.phone) }}
        {{ form_row(form.birthDate) }}
        {{ form_row(form.foreignBorn) }}
        <div
            data-id="birth-place"
            data-form-modifier-target="container"
        >
            {{ form_row(form.birthCommune) }}
            {{ form_row(form.birthPlace) }}
            {{ form_row(form.birthCountry) }}
        </div>
        {% if form.profession is defined %}
            {{ form_row(form.profession) }}
        {% endif %}
        {{ form_errors(form) }}
    </div>
{% endblock %}
