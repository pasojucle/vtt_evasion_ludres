{% extends 'base_admin.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
    <div class="p-4 lg:p-6 2xl:p-12">
        <div class="flex gap-2">
            <div>
                <h1 class="font-bold text-3xl">Tableau de bord</h1>
                <div class="text-muted mt-1">
                    Votre espace de pilotage en temps réel. Retrouvez ici les indicateurs clés de l'association.
                </div>
            </div>
        </div>
        <div class="flex flex-wrap gap-3 mb-20 mt-4">
            <turbo-frame id="crontab" src="{{ path('admin_dashboard_crontab') }}"  class="w-full flex-auto rounded-md border border-border">
                <div class="animate-pulse">
                    <div class="h-10 w-full bg-slate-200"></div>
                </div>
            </turbo-frame>
            {% for bikeRide in widgets.bikeRides %}
                <div class="flex flex-1 min-w-80 bg-slate-100">
                    <a 
                        href="{{ path('admin_cluster_list_activity', {'bikeRide': bikeRide.id})}}" 
                        class="w-full rounded-md border border-border"
                    >
                        <div class="bg-slate-300 flex items-center justify-center h-8 text-xs font-semibold uppercase">
                            <h2>{{ bikeRide.title }} du {{ bikeRide.period }}</h2>
                        </div>
                        <turbo-frame 
                            id="dashboard-bike-ride-{{ bikeRide.id}}" 
                            src="{{ path('admin_dashboard_bike_ride', {'bikeRide' : bikeRide.id}) }}"  
                        >
                            <div class="animate-pulse flex flex-col gap-2 p-3">
                                <div class="flex">
                                    <div class="h-4 w-28 bg-slate-200"></div>
                                    <div class="ml-auto h-4 w-4 bg-slate-200"></div>
                                </div>
                                <div class="flex">
                                    <div class="h-4 w-36 bg-slate-200"></div>
                                    <div class="ml-auto h-4 w-4 bg-slate-200"></div>
                                </div>
                                <div class="flex">
                                    <div class="h-4 w-32 bg-slate-200"></div>
                                    <div class="ml-auto h-4 w-4 bg-slate-200"></div>
                                </div>
                                <div class="flex">
                                    <div class="h-4 w-24 bg-slate-200"></div>
                                    <div class="ml-auto h-4 w-4 bg-slate-200"></div>
                                </div>
                                <div class="flex">
                                    <div class="h-4 w-32 bg-slate-200"></div>
                                    <div class="ml-auto h-4 w-4 bg-slate-200"></div>
                                </div>
                                <div class="flex">
                                    <div class="h-4 w-28 bg-slate-200"></div>
                                    <div class="ml-auto h-4 w-4 bg-slate-200"></div>
                                </div>
                            </div>
                        </turbo-frame>
                    </a>
                </div>
            {% endfor %}
            {% for participation in widgets.participations %}
                <div class="flex-1 min-w-80 rounded-md border border-border bg-slate-100">
                    <div class="bg-slate-300 flex items-center justify-center h-8 text-xs font-semibold uppercase">
                        <h2>{{ participation.title }}</h2>
                    </div>
                    <div class="p-3">
                        <div class="content-center"
                            data-controller="line-chart"
                            data-line-chart-url-value="{{ path('admin_participation_monthly', {'isSchool': participation.isSchool})}}"
                        >
                            <canvas 
                                id="school_line_chart_{{ loop.index }}" 
                                class="w-full"
                                data-line-chart-target="canvas"
                            ></canvas>
                        </div>
                    </div>
                </div>
            {% endfor %}
            {% for list in widgets.lists %}
            <div class="flex-1 min-w-80 rounded-md border border-border bg-slate-100">
                <a href="{{ list.url }}">
                    <div class="bg-slate-300 flex items-center justify-center h-8 text-xs font-semibold uppercase">
                        <h2>{{ list.title }}</h2>
                    </div>
                    <turbo-frame 
                        id="{{ list.id }}" 
                        src="{{ list.frameUrl }}" 
                    >
                        <div class="animate-pulse flex flex-col gap-2">
                            <div class="h-4 w-full bg-slate-200"></div>
                            <div class="h-4 w-full bg-slate-200"></div>
                        </div>
                    </turbo-frame>
                </a>
            </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
