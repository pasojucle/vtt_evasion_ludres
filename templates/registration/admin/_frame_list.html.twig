<turbo-frame id="registration-list" data-with-skeleton="true">
    {% include "components/_list_skeleton.html.twig" with {title: "Inscriptions"} %}
    <div class="block [turbo-frame[busy]>&]:hidden transition-opacity duration-200">
        <div class="border border-border rounded-md">
            <div class="bg-slate-300 pl-4 py-0.5 flex items-center">
                <div class="uppercase text-white text-sm">
                    Inscriptions - <span class="">{{ list.paginator.total }}
                </div>
                <div class="ml-auto">
                    {% include 'components/_dropdown.html.twig'  with {dropdown: list.tools} %}
                </div>
            </div>
            <ul id="registrations_container">
                {% for item in list.items %}
                    <li class="group relative grid grid-cols-1 lg:grid-cols-[1fr_112px] items-center lg:gap-4 not-last:border-b not-last:border-border lg:pr-4">
                        <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] group relative items-center gap-x-4 gap-y-2 p-3 pr-6 text-foreground lg:text-foreground/60 lg:hover:text-foreground bg-slate-100 hover:bg-slate-200 transition-colors">
                            <a href="{{ item.url }}" class="absolute inset-0 z-10 mr-10" title="Voir l'élément" data-turbo-frame="_top">
                                <span class="sr-only">Voir l'élément</span>
                            </a>
                            {% include 'components/_list_item.html.twig' with {
                                item: item, 
                                grid_template_labels: 'grid-cols-1', 
                                grid_template_badges: 'grid-cols-1 lg:grid-cols-[auto_180px]'
                                } %} 
                            {% include 'components/_dropdown.html.twig' with {dropdown: item.dropdown} %}
                        </div>
                        <div>
                            {% if item.action %}
                            <div class="px-4 py-2 lg:p-0">
                                {% include 'components/_button.html.twig' with {button: item.action} %}
                            </div>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
            {% if list.items is empty %}
                {% include "components/_empty.html.twig" with {icon: 'lucide:circle-x', message: 'Aucun résultat'} %}
            {% endif %}
        </div>
        {% include 'components/pagination.html.twig' with {'paginator': list.paginator, 'margin': 'top'} %}
    </div>
</turbo-frame>