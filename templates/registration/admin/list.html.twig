{% extends 'base_admin.html.twig' %}

{% block title %}Adhérents{% endblock %}

{% block body %}
    <div class="p-4 lg:p-6">
        <div class="flex mt-4">
            <div>
                <h1 class="font-bold text-3xl">Gestion des inscriptions</h1>
                <div class="text-muted mt-1">Administration des inscriptions pour la saison {{ app.session.get('currentSeason') }}</div>
            </div>
            
            <div class="ml-auto">
                <div class="flex flex-col lg:flex-row items-center rounded-sm divide-y lg:divide-y-0 lg:divide-x divide-white">
                    {% include 'components/_dropdown.html.twig' with {dropdown: list.settings} %}
                </div>
            </div>
        </div>
        <div class="mt-4" data-controller="filter">
            <div class="flex gap-4">
                <div class="flex items-center gap-4">
                    <div class="border border-border rounded-sm flex items-center gap-2">
                        <div class="flex items-center p-2 rounded-l-sm bg-slate-500">{{ ux_icon('lucide:funnel', {'class': 'text-white'}) }}</div>
                        {{ form_start(form) }}
                            <div class="flex items-center gap-4">
                                {{ form_row(form.status)}}
                            </div>
                        {{ form_end(form) }} 
                    </div>
                    <div class="ml-auto">
                        {% include 'components/_button.html.twig' with {button: list.advancedFilter} %}     
                    </div>
                </div>
            </div>
            {% include 'components/_filter_chips.html.twig' with {chips: list.filterChips} %}
        </div>
        {% include('registration/admin/_frame_list.html.twig') %}
    </div>
{% endblock %}
