<div 
    data-id="product-medias" 
    data-form-modifier-target="container"
>
    <div 
        class="{% if form.vars.row_attr.class is defined %}{{ form.vars.row_attr.class }}{% endif %}" 
        data-controller="input-file"
    >
        <div>Image de présentation</div>
        <div 
            class="mt-1 h-120 flex flex-col justify-end gap-2 p-4 border border-border rounded-sm" 
            data-input-file-target="trigger" 
            data-action="click->input-file#selectFile"
        >
            <div class="flex-1 min-h-0 flex items-center justify-center">
                <img 
                    class="max-h-full max-w-full object-contain" src="{{ content.filePath }}" 
                    alt="{{ content.alt }}" 
                    data-input-file-target="media"
                >
            </div>
            <div class="flex justify-center">
                <button 
                    type="button"
                    data-input-file-target="placeholder" 
                    data-placeholder="placeholder" 
                    class="flex flex-col items-center justify-center gap-2 h-9 px-4 py-1 bg-slate-300 border border-border"
                >
                    <div class="flex items-center gap-2">
                        {{ ux_icon('lucide:upload') }}
                        <div>{{ content.filename is null ? "Ajouter une" : "Modifier l'" }} image</div>
                    </div>
                </button>
            </div>
        </div>
        {{ form_widget(form.file, {'attr':{
            'class': 'hidden', 
            'data-input-file-target': 'input', 
            'data-action': 'change->input-file#previewFile'
        }}) }}   
        {{ form_errors(form.file) }} 
    </div>
</div>