{% extends 'base_admin.html.twig' %}

{% block title %}{{ list.title }}{% endblock %}

{% block body %}
    <div class="p-4 lg:p-6">
        <div class="flex gap-2 mb-8">
            <div>
                <h1 class="font-bold text-3xl">{{ list.title }}</h1>
                <div class="text-muted mt-1">{{ list.description }}</div>
            </div>
            <div class="ml-auto">
                <div class="flex flex-col lg:flex-row items-center rounded-sm divide-y lg:divide-y-0 lg:divide-x divide-white">
                    {% if list.wiki is not null %}
                        {% include 'components/_button.html.twig' with {button: list.wiki} %}
                    {% endif %}
                    {% if list.settings is not null %}
                        {% include 'components/_dropdown.html.twig' with {dropdown: list.settings} %}
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="flex flex-col gap-4 lg:gap-6">
            <div data-controller="filter">
                <div class="flex flex-col lg:flex-row gap-4">
                    <div class="flex items-center gap-4">
                        <div class="border border-border rounded-sm flex items-center gap-2">
                            <div class="flex items-center p-2 rounded-l-sm bg-slate-500">{{ ux_icon('lucide:funnel', {'class': 'text-white'}) }}</div>
                            {{ form_start(form) }}
                                <div class="flex items-center gap-4">
                                    {% for child in form.children %}
                                        {{ form_row(child)}}
                                    {% endfor %}
                                </div>
                            {{ form_end(form) }} 
                        </div>
                        <div class="ml-auto">
                            {% include 'components/_button.html.twig' with {button: list.advancedFilter} %}     
                        </div>
                    </div>
                    {% if list.addItem %}
                        <div class="lg:ml-auto">
                            {% include 'components/_button.html.twig' with {button: list.addItem} %}
                        </div>
                    {% endif %}
                </div>
                {% include 'components/_filter_chips.html.twig' with {chips: list.filterChips} %}
            </div>
            {% include('components/list/_frame_list.html.twig') %}
        </div>
    </div>
{% endblock %}
