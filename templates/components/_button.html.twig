{% set base_classes = 'block transition' %}

{% set spaces_classes = button.label ? '' : 'p-2' %}

{% set size_classes = {
    (enum('App\\Dto\\Enum\\Size').SM.value): 'px-2 py-1',
    (enum('App\\Dto\\Enum\\Size').MD.value): 'px-3 py-2',
    (enum('App\\Dto\\Enum\\Size').LG.value): 'px-3 py-2 font-semibold',
    (enum('App\\Dto\\Enum\\Size').ICON.value): 'p-2',
} %}
{% set align_class = button.variant.value == 'dropdown' ? 'justify-start' : 'justify-center' %}

{% import "components/_macros.html.twig" as utils %}
<a href="{{ button.url }}" 
   title="{{ button.title ?? button.label }}"
   class="{{ base_classes }}  {{ utils.rounded_class(button.rounded.value) }} {{ utils.color_class(button.variant.value) }} hover:cursor-pointer"
    {% for attribut in button.htmlAttributes %}
        {{ attribut.name }}="{{ attribut.value }}"
    {% endfor %}
>
    <div class="flex {{ align_class }}">
        <div class="flex items-center gap-2 {{ size_classes[button.size.value] ?? size_classes.sm }}">
            {% if button.icon %}{{ ux_icon(button.icon) }}{% endif %}
            {% if button.label %}
                <div class="whitespace-nowrap overflow-hidden text-ellipsis max-w-48">{{ button.label}}</div>
            {% endif %}
        </div>
    </div>
</a>