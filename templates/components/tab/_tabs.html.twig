<div data-controller="tabs">
    <div class="flex flex-col">
        <div class="hidden md:flex bg-slate-100 divide-x divide-border border-b border-border">
            {% for tab in tabs %}
                <div 
                    class="flex-1 gap-2 p-2 relative flex items-center {% if loop.index == 1 %}bg-slate-300 {% else %}bg-slate-200{% endif %}"
                    data-tabs-target="trigger"
                    data-action="click->tabs#switchTab"
                    data-index="{{loop.index}}"
                >
                    {% if tab.color %}
                        <div 
                            class="w-1 self-stretch custom-background rounded-md"
                            style="--badge-color: {{ tab.color }};"
                        ></div>
                    {% endif %}
                    {% if tab.icon %}
                        <div>{{ ux_icon(tab.icon, {class: 'size-5'}) }}</div>
                    {% endif %}
                    <div>{{ tab.title }}</div>
                </div>
            {% endfor %}
        </div>
        <div>
            {% for tab in tabs %}
                <div 
                    class="flex items-center gap-2 p-2 border-b border-border lg:mb-4 {% if loop.index == 1 %}bg-slate-300 {% else %}bg-slate-200{% endif %} md:hidden"
                    data-tabs-target="trigger"
                    data-action="click->tabs#switchTab"
                    data-index="{{loop.index}}"
                >
                    {% if tab.color %}
                        <div 
                            class="w-1 self-stretch custom-background rounded-md"
                            style="--badge-color: {{ tab.color }};"
                        ></div>
                    {% endif %}
                    {% if tab.icon %}
                        <div>{{ ux_icon(tab.icon, {class: 'size-5'}) }}</div>
                    {% endif %}
                    <div>{{ tab.title }}</div>
                    <div 
                        class="ml-auto mr-2{% if loop.index == 1 %} rotate-90{% endif %}"
                        data-tabs-target="chevron"
                        data-index="{{loop.index}}"
                    >
                        {{ ux_icon('lucide:chevron-down')}}
                    </div>
                </div>
                <div  
                    class="flex flex-col gap-4 p-4 lg:p-6 2xl:p-10 2xl:gap-10{% if loop.index != 1 %} hidden{% endif %}"
                    data-index="{{loop.index}}"
                    data-tabs-target="panel"
                >
                    {% include tab.view.template with {(tab.view.name): tab.view} %}
                </div>
            {% endfor %}
        </div>
    </div>
</div>