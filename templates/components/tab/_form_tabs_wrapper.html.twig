{% extends 'base_admin.html.twig' %}

{% block title %}{{ view.title }}{% endblock %}

{% block body %}
    <div class="p-4 lg:p-6 2xl:p-12">
        <div class="flex gap-2 mb-8">
            <div>
                <h1 class="font-bold text-3xl">{{ view.title }}</h1>
                <div class="text-muted mt-1">{{ view.description }}</div>
            </div>
            <div class="ml-auto">
                <div class="flex flex-col lg:flex-row items-center rounded-sm divide-y lg:divide-y-0 lg:divide-x divide-white">
                    {% include "components/_link.html.twig" with {link: view.fallback} %}
                </div>
            </div>
        </div>
        
        {{ form_start(form) }}
        <div class="min-h-96 border border-border rounded-t-md">
            {% include 'components/tab/_tabs.html.twig' with { tabs: view.tabs } %}
        </div>
        <div class="w-full flex mt-4 lg:mt-6">
            <div class="ml-auto">
                {% include view.submit.template with {(view.submit.name): view.submit} %}
            </div>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}