{% extends 'base_modal_stimulus.html.twig' %}

{% set type = view.type %}

{% import "components/_macros.html.twig" as utils %}
{% block modal_title %}{{ view.title|capitalize }}{% endblock %}
{% block body %}
    <p>{{ view.message|raw }}</p>
    {% for child in form.children %}
        {{ form_row(child) }}
    {% endfor %}
{% endblock %}
{% block action %}
    <button 
        type="submit"
        class="flex justify-center rounded-md {{ utils.color_class(view.type.value) ??  utils.color_class('default')}}"
    >
    <div class="flex gap-3 items-center ">
        {{ ux_icon(view.icon, {class: 'size-5'}) }} {{ view.action|capitalize }}
    </div>
    </button>
{% endblock %}
