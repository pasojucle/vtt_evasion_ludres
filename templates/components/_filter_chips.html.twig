<turbo-frame id="filter_chips" class="flex flex-wrap gap-2">
    {% for chip in chips %}
        <div class="flex items-center gap-2 text-slate-400 bg-slate-200 px-2 py-1 rounded-sm text-sm font-semibold">
            <div class="">
                {{ chip.label }}
            </div>
            {% if chip.url %}
                <a 
                    class="hover:text-slate-500"
                    href="{{ chip.url }}"
                    data-turbo-frame="{{ chip.turboFrame }}"
                >
                    {{ ux_icon('lucide:x')}}
                </a>
            {% endif %}
        </div>
    {% endfor %}
</turbo-frame>

