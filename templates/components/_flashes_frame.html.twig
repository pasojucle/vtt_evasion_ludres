<turbo-frame id="turbo_flash_messages">
    <div class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-md w-full px-4 sm:px-0">
    {% dump(flashes) %}
        {% for label, messages in flashes %}
            {% for message in messages %}
                
                {% set color_classes = (label == 'success') 
                    ? 'bg-white border-l-4 border-emerald-500 text-slate-800 dark:bg-slate-900 dark:text-slate-100' 
                    : 'bg-white border-l-4 border-rose-500 text-slate-800 dark:bg-slate-900 dark:text-slate-100' 
                %}
                <div class="flex items-center justify-between gap-3 p-4 rounded-r-xl shadow-xl border border-slate-100 dark:border-slate-800 transform transition-all duration-500 ease-out translate-y-8 opacity-0 {{ color_classes }}"
                     role="alert"
                     id="flash_{{ loop.index }}"
                     data-controller="flash-messages"
                >
                    <div class="flex items-center gap-3">
                        {{ ux_icon(label == 'success' ? 'lucide:circle-check' : 'lucide:circle-alert', {
                            class: 'size-5 ' ~ (label == 'success' ? 'text-emerald-500' : 'text-rose-500')
                        }) }}
                        <span class="text-sm font-semibold">{{ message|trans }}</span>
                    </div>
                    
                    <button 
                        type="button" 
                        data-action="click->flash-messages#hide" 
                        class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
                    >
                        {{ ux_icon('lucide:x', {class: 'size-4'}) }}
                    </button>
                </div>

            {% endfor %}
        {% endfor %}
    </div>
</turbo-frame>