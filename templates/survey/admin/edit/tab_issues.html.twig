<div data-controller="collection" class="flex flex-col gap-4">
    <ul 
        class="grid grid-cols-1 gap-4" 
        data-collection-target="container" 
        data-index="{{ form.surveyIssues|length > 0 ? form.surveyIssues|last.vars.name + 1 : 0 }}" 
        data-prototype="{{ form_widget(form.surveyIssues.vars.prototype)|e('html_attr') }}"
    >
        {% for item in form.surveyIssues %}
            <li>{{ form_widget(item) }}</li>
        {% endfor %}
    </ul>
    <div>
        <button 
            type="button" 
            class="p-2 bg-slate-500 text-white rounded-sm flex items-center gap-2 add-bike-ride-track" 
            data-action="click->collection#addItem"
        >
            {{ ux_icon('lucide:circle-plus') }} Ajouter une question
        </button>
    </div>
</div>