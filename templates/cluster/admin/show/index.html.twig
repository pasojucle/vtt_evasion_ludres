<turbo-frame
    class="cluster-container mb-20"
    id="cluster-{{ view.id }}"
    data-controller="cluster"
>  
    <div id="cluster-participants-{{ view.id }}" class="flex flex-col gap-4">

        <div>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-2 lg:gap-4">
                {% for widget in view.widgets %}   
                    {% include widget.template with {(widget.name): widget} %}
                {% endfor %}
            </div>
        </div>
        <div class="border border-border rounded-md">
            <div class="bg-slate-300 pl-4 py-0.5 flex items-center min-h-8">
                <div class="uppercase text-white text-sm">
                    Participants
                </div>
                <div class="ml-auto">
                    {% include 'components/_dropdown.html.twig' with {dropdown: view.dropdown} %}
                </div>
            </div>
            <div>
                {% if view.participants | length > 0 %}
                    <ul class="divide-y divide-border">
                        {% for participant in view.participants %}   
                            {% include 'cluster/admin/show/_participant.html.twig' with {'participant': participant} %}
                        {% endfor %}
                    </ul>
                {% else %}
                    {% include "components/_empty.html.twig" with {icon: 'lucide:users', message: 'Aucun participants'} %}
                {% endif %}
            </div>
        </div>
    </div>

    {# <div class="cluster-title">
        <h2>{{ view.title }} - 
            <span class="badge badge-info" data-cluster-target="countBadge">{{ view.usersOnSiteCount }}</span>
            {% if view.hasSkills %}
                <span class="badge badge-info"><i class="fa-solid fa-graduation-cap"></i></span>
            {% endif %}
        </h2>
            {% if bikeRide.isEditable or view.hasSkills %}
            <div class="dropdown">
                <button class="dropdown-toggle" type="button" data-toggle="dropdown-tools"></button>
                <div class="dropdown-menu" data-target="dropdown-tools">
                    <ul class="dropdown-body">
                        {% if bikeRide.isEditable %}
                            <li>
                                <a 
                                    href="{{ path('admin_cluster_edit', {'bikeRide': bikeRide.id, 'cluster': view.id}) }}" 
                                    class="dropdown-item" title="Renomer"
                                    data-turbo-frame="_top"
                                >
                                    <i class="fa-solid fa-pen-to-square"></i> Renommer
                                </a>
                            </li>
                        {% endif %}
                        {% if bikeRide.bikeRideType.useLevels %}
                            <li>
                                <a 
                                    href="{{ path('admin_cluster_skills', {'cluster': view.id}) }}" 
                                    class="dropdown-item" 
                                    title="Évaluations"
                                    data-turbo-frame="_top"
                                >
                                    <i class="fa-solid fa-graduation-cap"></i> Évaluation
                                </a>
                            </li>
                        {% endif %}
                        {% if 0 == view.sessions|length and bikeRide.isEditable %}
                            <li>
                                <a 
                                    href="{{ path('admin_cluster_delete', {'cluster': view.id}) }}" 
                                    class="dropdown-item" 
                                    title="Supprimer"
                                    data-turbo-frame="_top"
                                >
                                    <i class="fa-solid fa-circle-xmark"></i> Supprimer
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        {% endif %}
    </div>
    {% if view.sessions | length > 0 %}
        <ul>
            {% for session in view.sessions %}   
                {% include 'session/admin/list.html.twig' with {'user': session.user} %}
            {% endfor %}
        </ul>
        {% if not bikeRide.isPublic and view.isEditable and view.title != constant('App\\Entity\\Cluster::CLUSTER_FRAME') %}
            <div>
                {% if not view.isComplete %}
                    <a 
                        href="#" 
                        class="btn btn-100 btn-success cluster-complete{% if not bikeRide.isEditable %} disabled{% endif %}" 
                        data-action="click->cluster#complete"
                    >
                        <i class="fas fa-check"></i> Valider le groupe
                    </a>
                {% else %}
                    <div class="row row-list">
                        <div class="col-md-9 col-xs-8">
                            <a href="#" 
                                class="btn btn-100 btn-danger cluster-complete{% if not bikeRide.isEditable %} disabled{% endif %}" 
                                data-action="click->cluster#unlock"
                            >
                                <i class="fas fa-unlock-alt"></i> Déverrouiller le groupe
                            </a>
                        </div>
                        <div class="col-md-3 col-xs-4">
                            <a 
                                href="#" 
                                class="btn btn-100 btn-success{% if not bikeRide.isEditable %} disabled{% endif %}"
                                data-action="click->cluster#exportCluster"
                            >
                                <i class="fas fa-file-pdf"></i> Exporter
                            </a>
                        </div>
                    </div>
                {% endif %}
            </div>
        {% endif %}
    {% else %}
        <p class="padding-10">Aucun inscrit</p>
    {% endif %} #}
</turbo-frame>
