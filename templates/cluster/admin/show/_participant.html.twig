{% set unavailable = enum('App\\Entity\\Enum\\AvailabilityEnum').UNAVAILABLE %}
{% set noneAvailability = enum('App\\Entity\\Enum\\AvailabilityEnum').NONE %}
<li class="grid grid-cols-[1fr_60px] group relative 
    lg:gap-4 items-center gap-x-4 gap-y-2 p-3 pr-6 text-foreground lg:text-foreground/60 
    lg:hover:text-foreground bg-slate-100 hover:bg-slate-200 transition-colors">
    <a 
        href="{{ participant.url }}" 
        class="absolute inset-0 z-10 mr-10 lg:w-[calc(100%-60px)]" 
        title="Voir l'élément" 
        data-turbo-frame="_top"
    >
        <span class="sr-only">Voir l'élément</span>
    </a>
    <div 
        id="participant-{{ participant.sessionId}}"
        class="grid gid-cols-1 lg:grid-cols-[2fr_1fr] gap-2"
    >
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 items-center">
            <div>{{ participant.fullName }}</div>
            <div>
                {% include participant.level.template with {(participant.level.name): participant.level} %}
            </div>
        </div>
        <div class="flex gap-1">
            {% for badge in participant.indicators %}
                {% include badge.template with {(badge.name): badge} %}
            {% endfor %}
        </div>
    </div>
    {% if participant.status %}
        <div>
            {% include participant.status.template with {(participant.status.name): participant.status} %}
        </div>
    {% endif %}
    
    {% include 'components/_dropdown.html.twig' with {dropdown: participant.dropdown} %}
</li>