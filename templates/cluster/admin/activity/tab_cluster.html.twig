<turbo-frame
    class="cluster-container"
    id="cluster-{{ content.id }}" 
    src="{{ path('admin_cluster_show', {'cluster': content.id })}}"
    data-controller="cluster"
    data-cluster-refresh-interval-value="60000"
    data-cluster-complete-value="{{ path('admin_cluster_complete', {'cluster': content.id}) }}"
    data-cluster-unlock-value="{{ path('admin_cluster_complete', {'cluster': content.id}) }}"
    data-cluster-export-value="{{ path('admin_cluster_export', {'cluster': content.id}) }}"
    data-cluster-cluster-id-value="{{ content.id }}"
    data-action="participation:status-changed->cluster#updateTotal"
>
    <div class="block !mt-0">
        <div class="animate-pulse flex flex-col gap-2">
            <div class="block !mt-0">
                <div class="animate-pulse flex flex-col gap-2">
                    <div class="flex gap-2">
                        <div class="h-12 flex-1 bg-slate-200"></div>
                        <div class="h-12 w-8 bg-slate-200"></div>
                    </div>
                    <div class="flex gap-2">
                        <div class="h-12 flex-1 bg-slate-200"></div>
                        <div class="h-12 w-8 bg-slate-200"></div>
                    </div>
                    <div class="flex gap-2">
                        <div class="h-12 flex-1 bg-slate-200"></div>
                        <div class="h-12 w-8 bg-slate-200"></div>
                    </div>
                    <div class="flex gap-2">
                        <div class="h-12 flex-1 bg-slate-200"></div>
                        <div class="h-12 w-8 bg-slate-200"></div>
                    </div>
                    <div class="h-10 w-full bg-slate-200"></div>
                </div>
            </div>
        </div>
    </div>
</turbo-frame>