<turbo-frame
    class="cluster-container"
    id="cluster-{{ content.id }}" 
    src="{{ content.url }}"
    data-controller="cluster"
    data-cluster-refresh-interval-value="60000"
    data-cluster-export-url-value="{{ content.exportUrl }}"
    data-cluster-cluster-id-value="{{ content.id }}"
>
    <div class="block !mt-0">
        <div class="animate-pulse flex flex-col gap-2">
            <div class="block !mt-0">
                <div class="animate-pulse flex flex-col gap-2">
                    <div class="flex gap-2">
                        <div class="h-12 flex-1 bg-slate-200"></div>
                        <div class="h-12 w-8 bg-slate-200"></div>
                    </div>
                    <div class="flex gap-2">
                        <div class="h-12 flex-1 bg-slate-200"></div>
                        <div class="h-12 w-8 bg-slate-200"></div>
                    </div>
                    <div class="flex gap-2">
                        <div class="h-12 flex-1 bg-slate-200"></div>
                        <div class="h-12 w-8 bg-slate-200"></div>
                    </div>
                    <div class="flex gap-2">
                        <div class="h-12 flex-1 bg-slate-200"></div>
                        <div class="h-12 w-8 bg-slate-200"></div>
                    </div>
                    <div class="h-10 w-full bg-slate-200"></div>
                </div>
            </div>
        </div>
    </div>
</turbo-frame>