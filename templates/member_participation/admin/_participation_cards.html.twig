<div 
    class="grid grid-cols-1 lg:grid-cols-2 gap-4 2xl:gap-12"
>
    <div class="lg:col-span-2">
        <div class="size-max">
            <div class="flex gap-4 items-center">
                <div class="text-muted font-semibold uppercase tracking-wider ">
                    {{ view.period }}
                </div>
                <div>
                    {{ view.type }}
                </div>
                <div>
                    {% include view.filterAction.template with {(view.filterAction.name): view.filterAction} %}
                </div>
            </div>
        </div>
    </div>

    <div class="rounded-md border border-border">
        {% include "member_participation/admin/_activities.html.twig" %}
    </div>
    <div class="flex flex-col gap-4">
        {% if view.totalIndemnity %}
            <div class="rounded-md border border-border">
                <div class="px-4 bg-slate-300 flex items-center h-8 text-xs font-semibold uppercase text-white">
                    <h2>Indemnités</h2>
                </div>
                <div class="p-4 2xl:p-6">
                    <dl class="flex flex-col gap-4 text-sm">
                        <div class="flex gap-1">
                            <dt class="text-xs font-semibold uppercase tracking-wider text-muted 2xl:leading-5">Total des indemnités sur la période</dt>
                            <dd class="ml-auto">
                                {% include view.totalIndemnity.template with {(view.totalIndemnity.name): view.totalIndemnity} %}
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>
        {% endif %}
        <div class="min-w-80 rounded-md border border-border bg-slate-100">
            <div class="px-4 bg-slate-300 flex items-center h-8 text-xs font-semibold uppercase text-white">
                <h2>Participation mensuelle</h2>
            </div>
            <div class="p-3">
                <div class="content-center"
                    data-controller="line-chart"
                    data-line-chart-data-value="{{ view.lineChartParticipations}}"
                    data-line-chart-scale-y-value="10"
                >
                    <canvas 
                        id="member_line_chart_{{ view.memberId }}" 
                        class="w-full"
                        data-line-chart-target="canvas"
                    ></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

