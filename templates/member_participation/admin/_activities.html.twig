<div class="px-4 bg-slate-300 flex items-center h-8">
    <div class="text-xs font-semibold uppercase text-white flex gap-2">
        <h2>Activités - {{ view.counter }}</h2>
    </div>
    <div class="ml-auto -mr-2">
        {# {% include view.action.template with {(view.action.name): view.action} %} #}
    </div>
</div>
<div class="p-4 2xl:p-6">
    {% if view.activities|length == 0 %}
        <div 
            class="border border-border rounded-sm p-4"
            data-collection-target="empty"
        >
            {% include 'components/_empty.html.twig' with {icon: 'lucide:bike', message: 'Aucune activités'} %}
        </div>
    {% endif %}
    <ul class="flex flex-col gap-2 text-sm divide-y divide-border">
        {% for activity in view.activities %}
            <li class="grid grid-cols-[auto_60px_60px] items-center">
                <div class="flex flex-col gap-1">
                    <div class="text-xs font-semibold uppercase tracking-wider text-muted">{{ activity.period }}</div>
                    <div>{{ activity.title }}</div>
                </div>
                <div>
                    {% include activity.practice.template with {(activity.practice.name): activity.practice} %}
                </div>
                <div class="flex justify-end font-mono">
                    {% if activity.indemnity %}
                        {% include activity.indemnity.template with {(activity.indemnity.name): activity.indemnity} %}
                    {% endif %}
                </div>
            </li>
        {% endfor %}   
    </ul>
</div>
