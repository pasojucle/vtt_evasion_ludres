<div class="px-4 bg-slate-300 flex items-center h-8">
    <div class="text-xs font-semibold uppercase text-white flex gap-2">
        <h2>Activités - {{ view.counter }}</h2>
    </div>
    <div class="ml-auto -mr-2">
        {% include view.exportAction.template with {(view.exportAction.name): view.exportAction} %}
    </div>
</div>
<div class="p-4 2xl:p-6">
    {% if view.activities|length == 0 %}
        <div 
            class="border border-border rounded-sm p-4"
            data-collection-target="empty"
        >
            {% include 'components/_empty.html.twig' with {icon: 'lucide:bike', message: 'Aucune activités'} %}
        </div>
    {% endif %}
    <ul 
        class="flex flex-col text-sm divide-y divide-border"
        id="member-participation-rows-{{ view.memberId }}"
    >
        {% include "member_participation/admin/_activity_rows.html.twig" with {activities: view.activities} %}
    </ul>
    <div id="member-participation-load-more-{{ view.memberId }}" class="mt-4 text-center">
        {% if view.loadMoreAction %}
            {% include view.loadMoreAction.template with {(view.loadMoreAction.name): view.loadMoreAction} %}
        {% endif %}
    </div>
</div>
