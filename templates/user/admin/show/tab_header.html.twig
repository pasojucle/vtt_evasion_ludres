<div>
    <h1 class="font-bold text-3xl">{{ header.fullName }}</h1>
    <div class="flex flex-col gap-1 mt-1">
        <div class="flex items-center gap-2 text-muted">
            {{ header.levelType }}
            {% include header.level.template with {(header.level.name): header.level }%}
        </div>
        <div class="flex gap-2 text-muted">
            <div>Autorisation{% if 1 < header.authorizations|length %}s{% endif %}</div>
            {% for authorization in header.authorizations %}
                {% include authorization.template with {(authorization.name): authorization }%}
            {% endfor %}
        </div>
    </div>
</div>