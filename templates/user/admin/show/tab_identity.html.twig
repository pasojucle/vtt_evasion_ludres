
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 2xl:gap-12">
    <div class="rounded-md border border-border">
        <turbo-frame 
            id="identity-{{ content.identityId }}"
            src="{{ path('admin_identity_show', {identity: content.identityId}) }}"
        >
            <div class="px-4 bg-slate-300 flex items-center h-8">
                <div class="text-xs font-semibold uppercase text-white">
                    <h2>Identité</h2>
                </div>
            </div>
            <div class="animate-pulse p-4 2xl:p-6">
                <dl class="flex flex-col gap-4 text-sm">
                    <div class="flex flex-col gap-1">
                        <dt class="h-4 w-28 bg-slate-200"></dt>
                        <dd class="h-4 w-32 bg-slate-200"></dd>
                        <dd class="h-4 w-52 bg-slate-200"></dd>
                    </div>

                    <div class="flex flex-col gap-1">
                        <dt class="h-4 w-32 bg-slate-200"></dt>
                        <dd class="h-4 w-48 bg-slate-200"></dd>
                        <dd class="h-4 w-48 bg-slate-200"></dd>
                    </div>

                    <div class="flex flex-col gap-1">
                        <dt class="h-4 w-24 bg-slate-200"></dt>
                        <dd class="h-4 w-60 bg-slate-200"></dd>
                    </div>

                    <div class="flex flex-col gap-1">
                        <dt class="h-4 w-32 bg-slate-200"></dt>
                        <dd class="h-4 w-63 bg-slate-200"></dd>
                    </div>

                </dl>
            </div>
        </turbo-frame>
    </div>
    <div class="flex flex-col gap-4">
        {% for gardian in content.gardians %}
            <div class="rounded-md border border-border">
                <turbo-frame 
                    id="gardian-{{ gardian.id }}"
                    src="{{ path('admin_gardian_show', {gardian: gardian.id}) }}"
                >
                    <div class="px-4 bg-slate-300 flex items-center h-8 text-xs font-semibold uppercase text-white">
                        <h2>{{ gardian.kind }}</h2>
                    </div>
                    <div class="animate-pulse p-4 2xl:p-6">
                        <dl class="flex flex-col gap-4 text-sm">
                            <div class="flex flex-col gap-1">
                                <dt class="h-4 w-28 bg-slate-200"></dt>
                                <dd class="h-4 w-32 bg-slate-200"></dd>
                            </div>

                            <div class="flex flex-col gap-1">
                                <dt class="h-4 w-32 bg-slate-200"></dt>
                                <dd class="h-4 w-63 bg-slate-200"></dd>
                            </div>

                        </dl>
                    </div>
                </turbo-frame>
            </div>
        {% endfor %}
        {% if content.emergencyContactId %}
            <div class="rounded-md border border-border">
                <turbo-frame 
                    id="emergency-contact-{{ content.emergencyContactId }}"
                    src="{{ path('admin_emergency_contact_show', {emergencyContact: content.emergencyContactId}) }}"
                >
                    <div class="px-4 bg-slate-300 flex items-center h-8 text-xs font-semibold uppercase text-white">
                        <h2>Contact d'urgence</h2>
                    </div>
                    <div class="animate-pulse p-4 2xl:p-6">
                        <dl class="flex flex-col gap-4 text-sm">
                            <div class="flex flex-col gap-1">
                                <dt class="h-4 w-28 bg-slate-200"></dt>
                                <dd class="h-4 w-32 bg-slate-200"></dd>
                            </div>

                            <div class="flex flex-col gap-1">
                                <dt class="h-4 w-32 bg-slate-200"></dt>
                                <dd class="h-4 w-63 bg-slate-200"></dd>
                            </div>

                        </dl>
                    </div>
                </turbo-frame>
            </div>
        {% endif %}
    </div>
</div>

