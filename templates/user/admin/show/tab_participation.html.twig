<div 
    class="grid grid-cols-1 lg:grid-cols-2 gap-4 2xl:gap-12"
    data-controller="filter-tab" 
>
    <div class="lg:col-span-2">
        <turbo-frame 
            id="member-participation-filter-{{ view.entity.id }}"
            src="{{ path('admin_member_participation_filter', view.entity.participationParams) }}"
        >
            <div class="flex flex-col lg:flex-row items-center gap-4">
                <div class="flex items-center p-2 rounded-l-sm bg-slate-500">{{ ux_icon('lucide:funnel', {'class': 'text-white'}) }}</div>
                <div class="flex gap-2 items-center">
                    <div class="h-4 w-28 bg-slate-200"></div>
                    <div class="h-4 w-4 bg-slate-200"></div>
                    <div class="h-4 w-28 bg-slate-200"></div>
                </div>
                <div class="h-4 w-52 bg-slate-200"></div>
            </div>
        </turbo-frame>
    </div>

    <div class="rounded-md border border-border">
        <turbo-frame 
            id="member-participation-{{ view.entity.id }}"
            src="{{ path('admin_member_participation_list', view.entity.participationParams) }}"
        >
            {% include "member_participation/admin/_activities_skeleton.html.twig" %}
        </turbo-frame>
    </div>
    <div class="flex flex-col gap-4">
        <div class="rounded-md border border-border">
            <turbo-frame 
                id="member-indemnity-{{ view.entity.id }}"
                {# src="{{ path('admin_member_level_show', {member: view.entity.id}) }}" #}
            >
                <div class="px-4 bg-slate-300 flex items-center h-8 text-xs font-semibold uppercase text-white">
                    <h2>Indemnités</h2>
                </div>
                <div class="animate-pulse p-4 2xl:p-6">
                    <dl class="flex flex-col gap-4 text-sm">
                        <div class="flex flex-col gap-1">
                            <dt class="h-4 w-28 bg-slate-200"></dt>
                            <dd class="h-4 w-32 bg-slate-200"></dd>
                        </div>
                    </dl>
                </div>
            </turbo-frame>
        </div>
        <div class="min-w-80 rounded-md border border-border bg-slate-100 p-3">
            <div class="content-center"
                data-controller="line-chart"
                data-line-chart-url-value="{{ path('admin_participation_monthly', {'isSchool': 0})}}"
                data-line-chart-format-value="card"
            >
                <canvas 
                    id="school_line_chart_{{ loop.index }}" 
                    class="line-chart"
                    data-line-chart-target="canvas"
                ></canvas>
            </div>
        </div>
    </div>

    
</div>

