{% set grid = 'grid-cols-1' %}
{% if not item.isResponseText and item.fullName %}
        {% set grid = 'grid-cols-[1fr_40px] items-center' %}
{% endif %}

<li class="group relative items-center gap-x-4 gap-y-2 p-3 pr-6 text-foreground bg-slate-100">
    <div 
        class="grid {{ grid }} gap-1 items-center"
    >
        {% if item.fullName %}
            <div class="text-foreground/60">{{ item.fullName }}</div>
        {% endif %}
        <div>{{ item.response }}</div>
    </div>                    
</li>
