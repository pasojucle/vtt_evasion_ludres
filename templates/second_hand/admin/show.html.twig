{% extends 'base_admin.html.twig' %}

{% block title %}Annonces d'occasion - {{ second_hand.name }}{% endblock %}

{% block body %}
    <div class="p-4 lg:p-6">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mt-4 pb-4">
            <div class="w-full">
                <h1 class="font-bold text-3xl">{{ second_hand.name }}</h1>
                <div class="flex gap-4 justify-between lg:justify-self-start">
                    <div class="text-muted mt-1">Créée le {{ second_hand.createdAt }}</div>
                    {% include "components/_badge.html.twig" with {badge: second_hand.state} %}
                </div>
            </div>
            <div class="flex items-center gap-2 self-start lg:self-center shrink-0">
                {% if second_hand.buttonEdit %}
                    {% include "components/_link.html.twig" with {link: second_hand.buttonEdit} %}
                {% endif %}
                {% if second_hand.buttonDelete %}
                    {% include "components/_link.html.twig" with {link: second_hand.buttonDelete} %}
                {% endif %}
            </div>
        </div>
        <div class="mt-4 flex flex-col gap-4">
            <div class="border border-border rounded-md flex flex-col" data-controller="lightbox">
                <div class="p-4 flex flex-col lg:flex-row items-center justify-center gap-4">
                    <div class="h-80">                            
                        <img 
                            class="second-hand mb-20 h-full object-contain rounded-md" 
                            src="{{ second_hand.mainImagePath }}"
                            alt="{{ second_hand.name }}"
                            data-lightbox-target="mainImage"
                        >
                    </div>
                    {% if second_hand.images|length > 1 %}
                    <div class="flex gap-2 h-14">
                        {% for image in second_hand.images %}
                            <img 
                                class="second-hand mb-20 h-14 w-14 object-cover rounded border border-border opacity-60 hover:opacity-100 transition-opacity cursor-pointer" 
                                src="{{ image.path }}" 
                                alt="{{ image.filename }}"
                                data-lightbox-src="{{ image.path }}"
                                data-action="click->lightbox#switch"
                            >
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
            </div>
            <div id="second_hand_container" class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div class="border border-border rounded-md flex flex-col">
                    <div class="bg-slate-300 uppercase pl-4 pr-2 py-2 text-white text-sm flex gap-4 items-center">
                        <div class="flex items-center">Détail</div>
                    </div>
                    <div class="p-4">
                        <div>
                            <p class="whitespace-pre-line">{{ second_hand.content|raw}}<p>
                        </div>
                        <div class="flex items-center justify-between mt-4 pt-4 border-t border-border">
                            <div class="flex gap-2 items-center">
                                {% include "components/_badge.html.twig" with {badge: second_hand.categoryBadge} %}
                                <div class="text-muted">{{ second_hand.categoryName }}</div>
                            </div>
                            <p class="text-2xl text-accent font-bold">{{ second_hand.price }}</p>
                        </div>
                        {% if second_hand.buttonValidate %}
                            <div class="mt-4">
                                {% include "components/_link.html.twig" with {link: second_hand.buttonValidate} %}
                            </div>
                        {% endif %}
                    </div>
                </div>
                <div class="border border-border rounded-md flex flex-col">
                    <div class="bg-slate-300 uppercase pl-4 pr-2 py-2 text-white text-sm flex gap-4 items-center">
                        <div class="flex items-center">Contact</div>
                    </div>
                    <div class="p-4">
                        <p class="font-bold">{{ second_hand.sellerName}}</p>
                        <p>{{ second_hand.sellerEmail }}</p>
                        <p>{{ second_hand.sellerPhone }}</p>
                    </div>
                </div>
            </div>
        </div>
        
    </div>
{% endblock %}