{% extends 'form_div_layout.html.twig' %}
{# 1. Pour tous les inputs classiques (text, date, number, etc.) SAUF radio et checkbox #}
{% block form_widget_simple %}
    {% set attr = attr|merge({
        'class': attr.class|default('') ~ ' w-full h-8 leading-8 px-2 py-1 border-none bg-slate-200 text-foreground disabled:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-400'
    }) %}
    {{ parent() }}
{% endblock %}

{# 2. Pour les listes déroulantes (select) #}
{% block choice_widget_collapsed %}
    {% set background =  form.vars.uses_autocomplete is same as (true) ? 'border border-slate-200' : ' bg-slate-200' %}
    {% set height =  form.vars.multiple is same as (true) ? ' min-h-8' : ' h-8' %}
    {% set attr = attr|merge({
        'class': attr.class|default('') ~ ' w-full leading-8 px-2 py-1 border-none text-foreground focus:outline-none'~ height ~ background
    }) %}
    {{ parent() }}
{% endblock %}


{# 3. Pour les zones de texte (textarea) #}
{% block textarea_widget %}
    {% set attr = attr|merge({
        'class': attr.class|default('') ~ ' w-full px-2 py-1 bg-slate-200 text-foreground focus:outline-none focus:ring-2 focus:ring-slate-400'
    }) %}
    {% if attr.class is not defined and 'min-h-' not in attr.class %}
        {% set attr = attr|merge({'class': attr.class ~ ' min-h-[80px]'}) %}
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block radio_widget %}
    {% set attr = attr|merge({
        'class': attr.class|default('') ~ ' hidden peer'
    }) %}
    {{ parent() }}
{% endblock %}

{% block form_label %}
    {% if 'radio' in block_prefixes %}
        {% set label_attr = label_attr|merge({
            'class': label_attr.class|default('') ~ " relative pl-8 leading-8 cursor-pointer select-none text-foreground transition-all" ~
            " before:content-[''] before:block before:absolute before:top-0 before:left-0 before:w-6 before:h-6 before:rounded-md before:bg-transparent before:border before:border-border before:transition-transform" ~
            " peer-checked:before:bg-slate-500 peer-checked::before:border-slate-500 peer-disabled:before:bg-muted" ~
            " after:content-['✓'] after:flex after:items-center after:justify-center after:absolute after:top-0 after:left-0 after:w-6 after:h-6 after:text-white"
        }) %}
    {% endif %}
    {{ parent() }}
{% endblock %}