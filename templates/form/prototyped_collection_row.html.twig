{% block prototyped_collection_row %}
    <div>
        {{ form_label(form) }}
        <div data-controller="collection" class="flex flex-col gap-4 border border-border rounded-sm p-2">
            <ul
                class="grid grid-cols-1 gap-4" 
                data-collection-target="container" 
                {% if prototype is defined and not disabled %}
                    data-index="{{ form|length > 0 ? form|last.vars.name + 1 : 0 }}" 
                    data-prototype="{{ form_widget(prototype)|e('html_attr') }}"
                {% endif %}
            >
                {% for child in form %}
                    {{ form_widget(child) }}
                {% endfor %}
            </ul>
            <div>
                <button 
                    type="button" 
                    class="p-2 bg-slate-500 text-white rounded-sm flex items-center gap-2 add-bike-ride-track" 
                    data-action="click->collection#addItem"
                >
                    {{ ux_icon('lucide:circle-plus') }} Ajouter
                </button>
            </div>
        </div>
    </div>
{% endblock prototyped_collection_row %}

{% block prototyped_collection_entry_widget %}
    <li class="collection-item">
        <div class="flex gap-2">
            {{ form_widget(form) }}  
            <button 
                type="button" 
                class="p-1 bg-destructive text-sm text-white rounded-sm flex items-center gap-2"
                data-action="click->collection#removeItem"
            >
                Supprimer
            </button>
        </div>
    </li>
{% endblock prototyped_collection_entry_widget %}