{% block custom_file_row %}
    {% set class = (form.vars.row_attr.class is defined) ? form.vars.row_attr.class : '' %}
    <div 
        class="{{ class }}"
        {% for attrname, attrvalue in form.vars.row_attr %} 
            {{ attrname }}="{{ attrvalue }}"
        {% endfor %}
    >
        <div class="flex gap-2">
            <button 
                class="input-file-button p-2 text-foreground bg-slate-300 rounded-sm" 
                type="button"
                data-input-file-target="trigger" 
                data-action="click->input-file#selectFile"
            >
                <div class="flex items-center gap-2">
                    {{ ux_icon('lucide:upload') }}
                    <div>{{ form.vars.label}}</div>
                </div>
                
            </button>

            <div data-input-file-target="filename" class="flex items-center gap-2">
                {% if form.vars.attr.preview is defined and form.vars.attr.preview is not null %}
                    <a href="{{form.vars.attr.preview}}" title="Visualiser" class="bg-slate-300 text-white flex items-center p-2 rounded-sm" data-turbo-frame="modal_content">
                        {{ ux_icon('lucide:eye') }}
                    </a>
                {% endif %}
                <div>
                    {% if form.vars.attr.filename is defined and form.vars.attr.filename is not null %}{{form.vars.attr.filename}}{% else %}Aucun fichier{% endif %}
                </div>
                
            </div>
        </div>
        {{ form_widget(form, {'attr':{'class': 'hidden', 'data-input-file-target': 'input', 'data-action': 'change->input-file#previewFile'}}) }}   
        {{ form_errors(form) }} 
    </div>
{% endblock %}