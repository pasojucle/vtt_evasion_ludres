{% block switch_permission_row %}
    {{ form_label(form) }}
    <div class="flex flex-col gap-2">
        {% for child in form.children %}
            {% set label = child.vars.label|trans %}
            {% set data_switch_on = 'Donner les accès ' ~ label %}
            {% set data_switch_off = 'Aucun accès ' ~ label %}
            <div 
                class="flex items-center gap-4 {% if form.vars.row_attr.class is defined %}{{ form.vars.row_attr.class }}{% endif %}" 
                data-controller="switch"
                data-switch-on-value="{{data_switch_on}}"
                data-switch-off-value="{{data_switch_off}}"
            >
                <label class="relative inline-block w-[30px] h-3.5 cursor-pointer select-none shrink-0">
                        
                    {{ form_widget(child, {'attr': {
                        'data-action': 'change->switch#change',
                        'data-switch-target': "input",
                        'class': 'sr-only peer'
                    }}) }}
                    
                    <span class="
                        absolute inset-0 rounded-full transition-all duration-300
                        bg-slate-200 peer-checked:bg-slate-500
                        peer-focus:ring-1 peer-focus:ring-blue-500
                        after:content-[''] after:absolute after:bg-white after:rounded-full after:transition-all after:duration-300
                        after:h-2.5 after:w-2.5 after:left-[2px] after:bottom-[2px]
                        peer-checked:after:translate-x-4
                    "></span>
                </label>
                
                <label 
                    for="{{ child.vars.id }}" 
                    class="text-sm font-medium select-none transition-colors text-foreground" 
                    data-switch-target="label"
                >
                    {% if child.vars.checked %} {{ data_switch_on }} {% else %} {{ data_switch_off }} {% endif %}
                </label>
            </div>
        {% endfor %}
    </div>
    
{% endblock %}
