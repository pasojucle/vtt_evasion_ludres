<turbo-stream action="update" target="member-skill-{{ view.memberSkill.id}}">
    <template>
        {% include 'member_skill/admin/_skill_row.html.twig' with {skill: view.memberSkill} %}
    </template>
</turbo-stream>

<turbo-stream action="update" target="member-skill-development-{{ view.memberId}}">
    <template>
        {% include 'member_skill/admin/_member_skill_development.html.twig' with {skill: view.memberSkillDevelopment} %}
    </template>
</turbo-stream>

{% if view.flashesView %}
    <turbo-stream action="replace" target="turbo_flash_messages">
        <template>
            {% include 'components/_flashes_frame.html.twig' with {flashes: view.flashesView.flashes} %}
        </template>
</turbo-stream>
{% endif %}
